+# Facebook page hygiene (Movies golden rule, Aug 2026): a Facebook value that
+# is a /p/, /php/ or /people/ URL is not a usable page URL, and a page shown as
+# a "Fan Page" / fanpage is not the official account -- such values must not be
+# kept in the data, so the cell fails.
+_FB_BAD_PATH_RE = re.compile(r"facebook\.com/(?:p|php|people)/", re.I)
+_FB_FANPAGE_RE = re.compile(r"fan[\s_-]?(?:page|club)|fanpage", re.I)
+
+
+def _chk_facebook_page_valid(val, row, rule):
+    v = _s(val)
+    if v == "":
+        return None, ""  # blank is a gap, not a bad value
+    for line in v.splitlines():
+        line = line.strip()
+        if line and (_FB_BAD_PATH_RE.search(line) or _FB_FANPAGE_RE.search(line)):
+            return SEV_FAIL, rule.get(
+                "message",
+                "Facebook page must not be a /p/, /php/ or /people/ URL or a 'Fan Page'.")
+    return None, ""
+
+
 CHECKS = {
